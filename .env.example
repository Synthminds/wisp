# Wisp environment — copy to .env.local (never commit real values).
# Secrets live only here / in the platform secret manager. Code reads env by
# NAME; it must never read or log .env* files.

# --- Database (Neon Postgres) ---
# App connection: the `authenticated` role. RLS applies. Used by all app code.
DATABASE_URL="postgres://authenticated:...@ep-xxx.neon.tech/wisp?sslmode=require"
# Migrations + `pnpm seed` only: neondb_owner (BYPASSRLS). NEVER used in app code.
DATABASE_URL_OWNER="postgres://neondb_owner:...@ep-xxx.neon.tech/wisp?sslmode=require"

# --- Auth (two users, no public signup) ---
# Session-cookie signing secret: `openssl rand -base64 32`
SESSION_SECRET=""
# scrypt hashes from `pnpm auth:hash '<password>'` — never the password itself
AUTH_WES_HASH=""
AUTH_RIA_HASH=""

# --- Scheduling / heartbeat ---
# Every cron call must present: Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=""
# All scheduling logic is America/New_York; store UTC, convert at the edge.
TZ="America/New_York"

# --- LLM (Phase 2+; never called in the 15-min heartbeat) ---
ANTHROPIC_API_KEY=""
# Intercom push-to-talk transcription only.
OPENAI_API_KEY=""

# --- Channels (Phase 2/3) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
# Verified parent numbers allowed to drive announcements (E.164, comma-separated).
ANNOUNCE_VERIFIED_NUMBERS=""

# --- Fleet (Phase 2.5+) ---
# Fully Kiosk REST passwords are referenced by ENV VAR NAME in the device
# registry (device.fkb_password_env), never stored in the database.
# Example: a device row with fkb_password_env="FKB_KITCHEN_PW" reads this:
FKB_KITCHEN_PW=""
